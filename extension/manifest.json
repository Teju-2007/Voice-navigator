{
  "manifest_version": 3,
  "name": "Voice Navigator",
  "version": "1.1.0",
  "description": "Voice-guided browser tasks that continue across clicks, forms, menus, and page transitions.",
  "permissions": ["offscreen", "activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://localhost:3000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Navigator"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["match.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
